{
  "name": "crazysupporthub",
  "version": "1.0.0",
  "private": true,
  "description": "Herramienta interna de tickets de soporte con integracion bidireccional con n8n",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "prisma:migrate": "npm run prisma:migrate -w backend",
    "prisma:seed": "npm run prisma:seed -w backend",
    "test:e2e": "npm run test:e2e -w backend"
  }
}
