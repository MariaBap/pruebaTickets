{
  "name": "crazysupporthub",
  "version": "1.0.0",
  "private": true,
  "description": "Herramienta interna de tickets de soporte con integracion bidireccional con n8n",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "prisma:migrate": "npm run prisma:migrate -w apps/backend",
    "prisma:seed": "npm run prisma:seed -w apps/backend",
    "test:e2e": "npm run test:e2e -w apps/backend"
  }
}
