generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  agent
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketCategory {
  billing
  technical
  account
  other
}

enum EnrichmentStatus {
  pending
  processing
  done
  failed
}

model User {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(120)
  email String @unique @db.VarChar(180)

  passwordHash String @db.VarChar(60)

  role Role @default(agent)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdTickets  Ticket[] @relation("TicketCreatedBy")
  assignedTickets Ticket[] @relation("TicketAssignedTo")

  @@map("users")
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  description String       @db.Text
  status      TicketStatus @default(open)

  createdById Int
  createdBy   User @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId Int?
  assignedTo   User? @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  priority       TicketPriority?
  category       TicketCategory?
  tags           String[]        @default([])
  
  enrichmentStatus EnrichmentStatus @default(pending)
  enrichedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([enrichmentStatus])
  @@index([createdById])
  @@index([assignedToId])
  @@index([createdAt])
  @@map("tickets")
}
