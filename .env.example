# ---------------------------------------------------------------------------
# CrazySupportHub — plantilla de variables de entorno.
# Copiar a `.env` y rellenar. El repo NUNCA contiene valores reales.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=<usuario-postgres>
POSTGRES_PASSWORD=<password-postgres>
POSTGRES_DB=crazysupporthub

# Cadena de conexion que usa Prisma.
# En Docker el host es el nombre del servicio (`postgres`); fuera de Docker, `localhost`.
# Ojo: si ya tienes un PostgreSQL instalado en la maquina ocupando el 5432,
# publica el contenedor en otro puerto (p. ej. 5433) y ajusta el puerto aqui.
DATABASE_URL=postgresql://<usuario-postgres>:<password-postgres>@postgres:5432/crazysupporthub?schema=public

# --- Backend (NestJS) -------------------------------------------------------
NODE_ENV=development
PORT=3000

# Secreto de firma del JWT. Generar uno propio, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<cadena-aleatoria-de-32-bytes-en-hex>
JWT_EXPIRES_IN=1d

# Origen permitido por CORS (la URL del frontend).
CORS_ORIGIN=http://localhost:5173

# --- Integracion con n8n ----------------------------------------------------
# SALIENTE: URL del webhook del workflow que la API llama al crear un ticket.
# Dentro de la red de Docker el host es `n8n`, NO `localhost`.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/ticket-created

# Timeout del disparo saliente. El POST a n8n no bloquea la respuesta al
# frontend, pero necesita un limite para no dejar peticiones colgadas.
N8N_WEBHOOK_TIMEOUT_MS=5000

# ENTRANTE: secreto compartido del callback de enriquecimiento.
# Debe ser identico al configurado en la credencial del nodo HTTP Request de n8n.
N8N_WEBHOOK_SECRET=<cadena-aleatoria-compartida-con-n8n>

# --- n8n --------------------------------------------------------------------
# URL de la API que el workflow llama de vuelta.
# Dentro de la red de Docker el host es `backend`, NO `localhost`.
BACKEND_CALLBACK_URL=http://backend:3000/api/webhooks/n8n/enrichment
GENERIC_TIMEZONE=America/Caracas

# Clave con la que n8n cifra sus credenciales guardadas.
N8N_ENCRYPTION_KEY=<cadena-aleatoria-para-cifrar-credenciales-de-n8n>

# --- Frontend (Vite) --------------------------------------------------------
# La consume el navegador del host, por eso aqui SI va `localhost`.
VITE_API_URL=http://localhost:3000/api

# --- Puertos publicados por docker-compose (opcionales) ---------------------
# Solo cambian que puerto del host se mapea a cada servicio. Los valores por
# defecto ya evitan el choque con un PostgreSQL instalado en la maquina.
POSTGRES_PORT=5433
BACKEND_PORT=3000
FRONTEND_PORT=5173
N8N_PORT=5678

# Version de la imagen de n8n. Fijada para que la entrega sea reproducible.
N8N_VERSION=2.36.9
